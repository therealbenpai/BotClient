{
  "name": "@therealbenpai/djs-client",
  "version": "3.1.5",
  "description": "A simple Discord.JS bot client",
  "main": "dist/index.js",
  "readme": "README.md",
  "types": "@types/index.d.ts",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "gendoc": "npx typedoc --options typedoc.config.cjs",
    "compile": "npx tsc --noCheck",
    "jit": "npx tsc --watch",
    "redoc": "eslint --fix && typedoc --options typedoc.config.cjs",
    "lint": "eslint ."
  },
  "keywords": [
    "discord.js",
    "discord",
    "bot",
    "javascript",
    "typescript",
    "client",
    "utilities",
    "configurable"
